# Copy to .env and fill in real values locally. Never commit .env.

# Outlook / OTP (live E2E only)
OUTLOOK_EMAIL=you@example.com
OUTLOOK_PASSWORD=changeme
OUTLOOK_INBOX_URL=https://outlook.cloud.microsoft/mail/inbox

# Registration account password used after OTP
ACCOUNT_PASSWORD=changeme
EMAIL_PREFIX=demo+
EMAIL_DOMAIN=@example.com

# Admin login (live E2E only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Optional OTP override
REGISTRATION_OTP=

# App / admin URLs (live E2E only)
APP_HOME_URL=https://example.com/
APP_LOGIN_URL=https://example.com/login
APP_REGISTER_URL=https://example.com/register
APP_VERIFY_PROFILE_URL=https://example.com/verify-profile
ADMIN_URL=https://example.com/admin/
ADMIN_VERIFICATIONS_URL=https://example.com/admin/verifications
ADMIN_USERS_URL=https://example.com/admin/users

# Local folder with ID verification sample images (live E2E only)
ID_VERIFICATION_IMAGE_FOLDER=

# Playwright
PLAYWRIGHT_HEADLESS=true
# Set to 1 to include the Freya live woman E2E project
RUN_LIVE_E2E=0
